# ============================================================
# Linkora — required environment variables
# Copy this file's contents into Vercel → Project → Settings → Environment Variables
# (or run `vercel env add <NAME>` for each one).
# ============================================================

# --- Database (Upstash Redis) ---
# Get these by adding the "Upstash for Redis" integration from the
# Vercel Marketplace to this project (Storage tab → Create/Connect Database).
# It injects these automatically — you usually won't type them by hand.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Auth ---
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# The email address that should automatically become admin the FIRST time
# it registers on the site. Set this to your own email before you sign up.
ADMIN_EMAIL=you@example.com
